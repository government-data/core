        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Jobs finished per hour",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- Jobs finished per hour: done, and failed for good (a failed attempt\n-- that goes back to the queue has no finish time).\nSELECT\n  $__timeGroupAlias(j.finished_at, '1h'),\n  count(*) FILTER (WHERE j.state = 'done') AS done,\n  count(*) FILTER (WHERE j.state = 'failed') AS failed\nFROM quality.jobs j\nWHERE $__timeFilter(j.finished_at)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "maxDataPoints": 100,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "done": "Done",
              "failed": "Failed"
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Worker machines allowed to work, per pool",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- Worker machines that may work, per pool, as registered: approved or\n-- draining, and how many of them hold a certificate still valid. Not\n-- whether they are alive.\nSELECT\n  coalesce(m.pool, '') AS pool,\n  count(*) FILTER (WHERE m.state = 'approved') AS approved,\n  count(*) FILTER (WHERE m.state = 'draining') AS draining,\n  count(*) FILTER (WHERE m.cert_not_after > now()) AS valid_certificate\nFROM public.machines m\nWHERE m.role = 'worker' AND m.state IN ('approved', 'draining')\nGROUP BY m.pool\nORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "pool": "Pool",
              "approved": "Approved",
              "draining": "Draining",
              "valid_certificate": "Valid certificate"
            }
          }
        }
      ]
    },

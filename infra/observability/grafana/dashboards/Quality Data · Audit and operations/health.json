    {
      "id": 2,
      "type": "table",
      "title": "Queue now, by kind",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- The queue now, by kind: ready to take, waiting for their backoff,\n-- running with a live lease, and running with a lease run out (back to the\n-- queue at the next claim).\nSELECT\n  j.kind,\n  count(*) FILTER (WHERE j.state = 'queued' AND j.not_before <= now()) AS ready,\n  count(*) FILTER (WHERE j.state = 'queued' AND j.not_before > now()) AS waiting,\n  count(*) FILTER (WHERE j.state = 'running' AND j.lease_until > now()) AS running,\n  count(*) FILTER (WHERE j.state = 'running' AND j.lease_until <= now()) AS lease_expired\nFROM quality.jobs j\nWHERE j.state IN ('queued', 'running')\nGROUP BY j.kind\nORDER BY j.kind",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "kind": "Kind",
              "ready": "Ready",
              "waiting": "Waiting (backoff)",
              "running": "Running",
              "lease_expired": "Lease run out"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Oldest ready job has waited",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"

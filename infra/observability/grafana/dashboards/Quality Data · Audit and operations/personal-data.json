          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- Views per person (the 20 with most).\nSELECT coalesce(u.display_name, u.email, a.service_account, '—') AS who, count(*) AS views\nFROM public.admin_audit_events a\nLEFT JOIN public.admin_users u ON u.id = a.admin_id\nWHERE $__timeFilter(a.occurred_at)\n  AND a.event_type = 'records_viewed'\n  AND ('__all' IN (${who:sqlstring}) OR a.admin_id::text IN (${who:sqlstring}))\n  AND (${resource:sqlstring} = '' OR strpos(a.resource, ${resource:sqlstring}) > 0)\nGROUP BY 1\nORDER BY 2 DESC, 1\nLIMIT 20",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "orientation": "horizontal",
        "showValue": "auto",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xField": "Who"
      },
      "transformations": [
        {
          "id": "organize",

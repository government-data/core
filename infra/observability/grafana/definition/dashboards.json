    {
      "slug": "quality",
      "folder": "folder_quality",
      "tags": ["quality-data", "quality"],
      "time": "now-30d",
      "timepicker": false,
      "variables": [
        {
          "name": "dataset",
          "multi": false,
          "all": false,
          "query": "SELECT DISTINCT dataset FROM quality.run_summary ORDER BY 1"
        },
        {
          "name": "cut",
          "query": "SELECT cut::text FROM quality.run_summary WHERE dataset = ${dataset:sqlstring} ORDER BY cut DESC LIMIT 60"
        },
        "previous_cut",
        "dimension",
        "drift_variable"
      ],
      "tables": "tables",
      "panels": [
        {
          "chart": "trend_by_cut",
          "w": 24,
          "h": 8,
          "columns": {
            "cut": { "unit": "time:YYYY-MM-DD" },

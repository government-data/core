            "igcd": { "unit": "percentunit", "decimals": 1, "max": 1 }
          }
        },
        {
          "chart": "failures_by_dimension",
          "w": 12,
          "h": 10,
          "limit": 15,
          "label": { "columns": ["dimension", "severity"], "value": "failures" },
          "columns": {
            "dimension": { "values": "dimensionName" },
            "failures": { "color": "#2a78d6" }
          }
        },
        {
          "chart": "failures_by_field",
          "w": 12,
          "h": 10,
          "sort": { "column": "failures", "desc": true },
          "limit": 15,
          "columns": {
            "rules": { "hide": true },
            "applies": { "hide": true },
            "failures": { "color": "#2a78d6" }
          }
        },
        {
          "chart": "lowest_icd",
          "w": 8,
          "h": 10,
          "limit": 15,
          "columns": { "icd": { "decimals": 2, "min": 0, "max": 1, "color": "#2a78d6" } }
        },
        {
          "chart": "icd_distribution",
          "w": 8,
          "h": 10,
          "orientation": "vertical",
          "columns": { "from_icd": { "text": true }, "entities": { "color": "#2a78d6" } }
        },
        {
          "chart": "bands_by_segment",
          "w": 8,
          "h": 10,
          "as": "barchart",
          "stacking": "percent",
          "limit": 15,
          "legendShown": true,
          "columns": {
            "high": { "label": "bandName.high", "color": "#0ca30c" },
            "medium": { "label": "bandName.medium", "color": "#fab219" },
            "low": { "label": "bandName.low", "color": "#d03b3b" }
          }
        },
        {
          "chart": "band_transitions",
          "w": 8,
          "h": 9,
          "matrix": {
            "rows": "from_band",
            "columns": "to_band",
            "value": "entities",
            "head": "transitionHead",
            "scheme": "continuous-blues"
          }
        },
        {
          "chart": "sfc_view",
          "w": 16,
          "h": 9,
          "as": "barchart",
          "min": null,
          "note": "sfcNote",
          "columns": {
            "ok": { "hide": true },
            "total": { "hide": true },
            "p": {
              "label": "sfcShare",
              "unit": "percentunit",
              "decimals": 1,
              "softMin": 0.7,
              "max": 1,
              "thresholds": [
                [null, "#d03b3b"],
                [0.8, "#fab219"],
                [0.9, "#0ca30c"]
              ],
              "thresholdsStyle": "dashed+area"
            },
            "passes": { "hide": true },
            "missing": { "hide": true },
            "margin": { "hide": true },
            "closeness": { "hide": true },
            "sfc": { "hide": true }
          }
        },
        {
          "chart": "groups_p_chart",
          "w": 24,
          "h": 9,
          "repeat": "dimension",
          "filter": "dimension",
          "note": "pChartNote",
          "position": {
            "value": "p",
            "low": "lcl",
            "high": "ucl",
            "as": "position",
            "steps": [
              [null, "#0ca30c"],
              [0, "#898781"],
              [1.0001, "#d03b3b"]
            ]
          },
          "series": {
            "x": "records",
            "points": "p",
            "color": "position",
            "lines": ["ucl", "lcl", "p_bar"]
          },
          "columns": {

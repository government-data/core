// The application VM's services' metrics (decision 0071, step 2): Alloy
// scrapes each one every 30 seconds, keeps only the metrics of point 8 and,
// per target, only the label names listed for it (point 10), and pushes
// them to Mimir. Loaded beside config.alloy (the logs), in /etc/qd-alloy.
//
// Where each target is comes from the environment (docker-compose.yml and
// its overlays): with certificate.yml over HTTPS, the CA verified and this
// machine's certificate presented (METRICS_CA_FILE, METRICS_CERT_FILE),
// read again when the node agent renews it; in development over plain HTTP
// inside Traefik's network namespace, both files empty.
//
//   traefik, grafana, dolt  Traefik's metrics entry point
//                           (METRICS_ROUTER_ADDRESS): its own metrics,
//                           /grafana/metrics with Grafana's basic auth,
//                           /dolt/metrics (infra/traefik/internal.yml)
//   loki, mimir             their own ports' /metrics
//   alloy                   itself, no network
//   files                   the API's metrics file, /run/qd-metrics (step 3)
//   postgres                app-postgres.alloy, with certificate.yml only
//   host                    the machine (decision 0072, step 1): its own
//                           /proc, the watched paths /host/watch/postgres,
//                           dolt and loki (their volumes) and the host's
//                           /proc/1/net, bound read-only by the compose file
//
// Every scrape fails whole, and `up` says so, past 5,000 samples (the
// host's 1,000) or 20 labels on a series (point 11). `job` and `instance` come from here, `vm`
// and `role` from the remote write, never from a target (but the API's
// qd_machine_approved, below). Every relabel
// keeps `__name__`, `job` and `instance`, then the target's own labels.
// What Mimir does not take waits in the write-ahead log under alloy-data.

prometheus.remote_write "mimir" {
  external_labels = {
    vm   = coalesce(sys.env("OBS_VM"), "dev"),
    role = "app",
  }

  endpoint {
    url = coalesce(sys.env("METRICS_PUSH_URL"), "http://mimir:9009/api/v1/push")

    tls_config {
      ca_file   = sys.env("METRICS_CA_FILE")
      cert_file = sys.env("METRICS_CERT_FILE")
      key_file  = sys.env("METRICS_CERT_FILE")
    }
  }
}

// --- Traefik: requests and latency by service and entry point, its certificates.
prometheus.scrape "traefik" {
  job_name        = "traefik"
  targets         = [{"__address__" = coalesce(sys.env("METRICS_ROUTER_ADDRESS"), "127.0.0.1:9445")}]
  metrics_path    = "/metrics"
  scheme          = coalesce(sys.env("METRICS_SCHEME"), "http")
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  sample_limit    = 5000
  label_limit     = 20

  tls_config {
    ca_file   = sys.env("METRICS_CA_FILE")
    cert_file = sys.env("METRICS_CERT_FILE")
    key_file  = sys.env("METRICS_CERT_FILE")
  }
  forward_to = [prometheus.relabel.traefik.receiver]
}

prometheus.relabel "traefik" {
  rule {
    source_labels = ["__name__"]
    regex         = "up|process_cpu_seconds_total|process_resident_memory_bytes|traefik_service_requests_total|traefik_service_request_duration_seconds_(bucket|sum|count)|traefik_entrypoint_requests_total|traefik_entrypoint_request_duration_seconds_(bucket|sum|count)|traefik_tls_certs_not_after"
    action        = "keep"
  }
  rule {
    regex  = "__name__|job|instance|code|method|protocol|service|entrypoint|le|cn|sans"
    action = "labelkeep"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// --- Grafana: whether its dashboards answer, through the same entry point.
prometheus.scrape "grafana" {
  job_name        = "grafana"
  targets         = [{"__address__" = coalesce(sys.env("METRICS_ROUTER_ADDRESS"), "127.0.0.1:9445")}]
  metrics_path    = "/grafana/metrics"
  scheme          = coalesce(sys.env("METRICS_SCHEME"), "http")
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  sample_limit    = 5000
  label_limit     = 20

  basic_auth {
    username      = "qd-metrics"
    password_file = coalesce(sys.env("GRAFANA_METRICS_PASSWORD_FILE"), "/run/secrets/grafana_metrics_password")
  }
  tls_config {
    ca_file   = sys.env("METRICS_CA_FILE")
    cert_file = sys.env("METRICS_CERT_FILE")
    key_file  = sys.env("METRICS_CERT_FILE")
  }
  forward_to = [prometheus.relabel.grafana.receiver]
}

prometheus.relabel "grafana" {
  rule {
    source_labels = ["__name__"]
    regex         = "up|process_cpu_seconds_total|process_resident_memory_bytes|grafana_http_request_duration_seconds_(bucket|sum|count)"
    action        = "keep"
  }
  rule {
    regex  = "__name__|job|instance|handler|method|status_code|le"
    action = "labelkeep"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// --- Dolt: connections and queries. No label names a database (a tenant's).
prometheus.scrape "dolt" {
  job_name        = "dolt"
  targets         = [{"__address__" = coalesce(sys.env("METRICS_ROUTER_ADDRESS"), "127.0.0.1:9445")}]
  metrics_path    = "/dolt/metrics"
  scheme          = coalesce(sys.env("METRICS_SCHEME"), "http")
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  sample_limit    = 5000
  label_limit     = 20

  tls_config {
    ca_file   = sys.env("METRICS_CA_FILE")
    cert_file = sys.env("METRICS_CERT_FILE")
    key_file  = sys.env("METRICS_CERT_FILE")
  }
  forward_to = [prometheus.relabel.dolt.receiver]
}

prometheus.relabel "dolt" {
  rule {
    source_labels = ["__name__"]
    regex         = "up|process_cpu_seconds_total|process_resident_memory_bytes|dss_concurrent_connections|dss_concurrent_queries|dss_connects|dss_disconnects|dss_query_duration_(bucket|sum|count)"
    action        = "keep"
  }
  rule {
    regex  = "__name__|job|instance|le"
    action = "labelkeep"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// --- Loki: lines taken and stored, its requests by route.
prometheus.scrape "loki" {
  job_name        = "loki"
  targets         = [{"__address__" = coalesce(sys.env("LOKI_METRICS_ADDRESS"), "loki:3100")}]
  metrics_path    = "/metrics"
  scheme          = coalesce(sys.env("METRICS_SCHEME"), "http")
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  sample_limit    = 5000
  label_limit     = 20

  tls_config {
    ca_file   = sys.env("METRICS_CA_FILE")
    cert_file = sys.env("METRICS_CERT_FILE")
    key_file  = sys.env("METRICS_CERT_FILE")
  }
  forward_to = [prometheus.relabel.loki.receiver]
}

// Loki's `tenant` (its one, `fake`) is dropped: no tenant label (point 10).
prometheus.relabel "loki" {
  rule {
    source_labels = ["__name__"]
    regex         = "up|process_cpu_seconds_total|process_resident_memory_bytes|loki_distributor_lines_received_total|loki_ingester_chunks_flushed_total|loki_request_duration_seconds_(bucket|sum|count)"
    action        = "keep"
  }
  rule {
    regex  = "__name__|job|instance|route|method|status_code|ws|reason|le"
    action = "labelkeep"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// --- Mimir: samples taken, shipped to the lake, refused.
prometheus.scrape "mimir" {
  job_name        = "mimir"
  targets         = [{"__address__" = coalesce(sys.env("MIMIR_METRICS_ADDRESS"), "mimir:9009")}]
  metrics_path    = "/metrics"
  scheme          = coalesce(sys.env("METRICS_SCHEME"), "http")
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  sample_limit    = 5000
  label_limit     = 20

  tls_config {
    ca_file   = sys.env("METRICS_CA_FILE")
    cert_file = sys.env("METRICS_CERT_FILE")
    key_file  = sys.env("METRICS_CERT_FILE")
  }
  forward_to = [prometheus.relabel.mimir.receiver]
}

// Mimir's `user` (its one tenant) is dropped as Loki's.
prometheus.relabel "mimir" {
  rule {
    source_labels = ["__name__"]
    regex         = "up|process_cpu_seconds_total|process_resident_memory_bytes|cortex_distributor_received_samples_total|cortex_ingester_shipper_uploads_total|cortex_discarded_samples_total"
    action        = "keep"
  }
  rule {
    regex  = "__name__|job|instance|reason|group"
    action = "labelkeep"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// --- The host (decision 0072, points 1 to 3): CPU, memory, load, disk I/O,
// the clock and the boot time from the container's own /proc, which is not
// namespaced for them; the watched paths' filesystems, each bound read-only
// at /host/watch/<name> (statfs, no file read); and the host's interfaces
// from /host/proc1/net, the host's /proc/1/net bound read-only (never the
// whole /proc). Two exporters: procfs_path moves every collector of its
// exporter, and `host`'s own netdev would see the container's namespace,
// so it is not run. Both are job `host`, `instance` naming the exporter.
// The scrape fails whole past 1,000 samples or 20 labels (point 3).
prometheus.exporter.unix "host" {
  set_collectors = ["cpu", "meminfo", "loadavg", "filesystem", "diskstats", "timex", "stat"]

  // Whole devices only: partitions, loop and RAM disks dropped.
  disk {
    device_exclude = "^(z?ram|loop|fd|(h|s|v|xv)d[a-z]|nvme\\d+n\\d+p)\\d+$"
  }
}

prometheus.exporter.unix "network" {
  set_collectors = ["netdev"]
  procfs_path    = "/host/proc1"

  netdev {
    device_exclude = "^(loop.*|ram.*|veth.*|docker.*|br-.*|lo)$"
  }
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "job"
    replacement  = "host"
  }
  rule {
    target_label = "instance"
    replacement  = "host"
  }
}

discovery.relabel "network" {
  targets = prometheus.exporter.unix.network.targets

  rule {
    target_label = "job"
    replacement  = "host"
  }
  rule {
    target_label = "instance"
    replacement  = "network"
  }
}

prometheus.scrape "host" {
  job_name        = "host"
  targets         = array.concat(discovery.relabel.host.output, discovery.relabel.network.output)
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  sample_limit    = 1000
  label_limit     = 20
  forward_to      = [prometheus.relabel.host.receiver]
}

// Point 1's keep list. A filesystem series is kept only for a watched path,
// its mountpoint renamed to the path's name (`docker`, `postgres`…): the
// collector also lists the container's own mounts (/etc/hosts…).
prometheus.relabel "host" {
  rule {
    source_labels = ["__name__"]
    regex         = "up|node_cpu_seconds_total|node_load1|node_load5|node_memory_(MemTotal|MemAvailable|SwapTotal|SwapFree)_bytes|node_filesystem_(size_bytes|avail_bytes|files|files_free|readonly)|node_disk_(read_bytes_total|written_bytes_total|io_time_seconds_total)|node_network_(receive|transmit)_(bytes|errs|drop)_total|node_timex_offset_seconds|node_timex_sync_status|node_boot_time_seconds"
    action        = "keep"
  }
  rule {
    source_labels = ["__name__", "mode"]
    regex         = "node_cpu_seconds_total;(nice|irq|softirq|steal|guest.*)"
    action        = "drop"
  }
  rule {
    source_labels = ["__name__", "mountpoint"]
    regex         = "node_filesystem_.+;/host/watch/[^/]+"
    target_label  = "__watched"
    replacement   = "1"
  }
  rule {
    source_labels = ["__name__", "__watched"]
    regex         = "node_filesystem_.+;"
    action        = "drop"
  }
  rule {
    source_labels = ["mountpoint"]
    regex         = "/host/watch/([^/]+)"
    target_label  = "mountpoint"
  }
  rule {
    regex  = "__name__|job|instance|cpu|mode|mountpoint|device"
    action = "labelkeep"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// --- Alloy itself: whether it sends, and whether it is behind.
prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy" {
  job_name        = "alloy"
  targets         = prometheus.exporter.self.alloy.targets
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  sample_limit    = 5000
  label_limit     = 20
  forward_to      = [prometheus.relabel.alloy.receiver]
}

prometheus.relabel "alloy" {
  rule {
    source_labels = ["__name__"]
    regex         = "up|process_cpu_seconds_total|process_resident_memory_bytes|loki_write_sent_entries_total|loki_write_dropped_entries_total|prometheus_remote_storage_samples_failed_total"
    action        = "keep"
  }
  // Its own names, never the container's id.
  rule {
    target_label = "job"
    replacement  = "alloy"
  }
  rule {
    target_label = "instance"
    replacement  = "alloy"
  }
  rule {
    regex  = "__name__|job|instance|component_id|host|reason|remote_name|url"
    action = "labelkeep"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// --- The API's metrics file (point 9): /run/qd-metrics/api.prom, written
// every 15 s in the volume data-quality-metrics, read with the embedded node
// exporter's textfile collector alone. No network. A stopped API shows as
// the file's age (node_textfile_mtime_seconds), a file it cannot read as
// node_textfile_scrape_error 1. Routes by template, kinds of the queue's
// list, the process's series by `service` (decision 0071, point 10).
// qd_machine_approved (decision 0072, point 4) is the one series that
// carries its own `vm` and `role`, an approved machine's name and role:
// the remote write's external labels do not replace a series' own.
// qd_machine_alerts_unknown_total counts Grafana's alerts of no known
// machine (0072, point 11).
prometheus.exporter.unix "files" {
  set_collectors = ["textfile"]

  textfile {
    directory = "/run/qd-metrics"
  }
}

prometheus.scrape "files" {
  job_name        = "files"
  targets         = prometheus.exporter.unix.files.targets
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  sample_limit    = 5000
  label_limit     = 20
  forward_to      = [prometheus.relabel.files.receiver]
}

prometheus.relabel "files" {
  rule {
    source_labels = ["__name__"]
    regex         = "up|node_textfile_mtime_seconds|node_textfile_scrape_error|process_cpu_seconds_total|process_resident_memory_bytes|qd_http_requests_total|qd_http_request_duration_seconds_(bucket|sum|count)|qd_queue_ready_jobs|qd_queue_oldest_ready_seconds|qd_machine_approved|qd_machine_alerts_unknown_total"
    action        = "keep"
  }
  // Its own names: the exporter's target says `integrations/unix` and the
  // container's id.
  rule {
    target_label = "job"
    replacement  = "files"
  }
  rule {
    target_label = "instance"
    replacement  = "files"
  }
  rule {
    regex  = "__name__|job|instance|file|service|route|status_class|kind|le|vm|role"
    action = "labelkeep"
  }
  forward_to = [prometheus.remote_write.mimir.receiver]
}

# Rust
/target
tools/verify/*/target/
tools/verify/*/Cargo.lock
**/*.rs.bk
Cargo.lock.orig

# Node / frontend (pnpm workspace)
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Test / coverage
coverage/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# TLS certificates (generate locally, never commit)
infra/traefik/certs/
# The internal entry point, written once the CA exists (gen-dev-internal.sh,
# the installer): its copy of infra/traefik/internal.yml and its certificates.
infra/traefik/dynamic/internal.yml
infra/traefik/dynamic/*.crt
infra/traefik/dynamic/*.key
# The application VM's machine certificate and key (certificate.yml).
infra/traefik/dynamic/*.pem

# Environment / secrets
.env
.env.*
!.env.example
# Docker-secret files for the prod compose overlay (compose.prod.yml) — real
# credentials, never committed.
/secrets/

# gt worktree harness (agent runtime injections; contain tokens — never commit)
/.claude/
/.gt-config/
/.mcp.json
/CLAUDE.md

# The types Astro generates when building a site.
.astro/


# Local working files (simulators, drafts)
/tmp/
# Watch mode's local state (tools/dev/api.sh, `task dev:watch`): the Settings
# key copied from the container and Traefik's config.
/.dev/

__pycache__/

tmp

# Internal documentation (decisions, implementation, roadmap): local only,
# never committed or published.
/docs/

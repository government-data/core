{
  "languages": ["es", "en"],
  "datasources": {
    "postgres": { "type": "grafana-postgresql-datasource", "uid": "postgres" },
    "loki": { "type": "loki", "uid": "loki" },
    "mimir": { "type": "prometheus", "uid": "mimir" }
  },
  "variables": {
    "event_type": {
      "kind": "query",
      "datasource": "postgres",
      "query": "SELECT DISTINCT event_type FROM public.admin_audit_events ORDER BY 1",
      "multi": true,
      "sample": "records_viewed"
    },
    "who": {
      "kind": "query",
      "datasource": "postgres",
      "query": "SELECT id::text AS __value, coalesce(display_name, email) AS __text FROM public.admin_users ORDER BY 2, 1",
      "multi": true
    },
    "resource": { "kind": "textbox", "sample": "dataset/" },
    "dataset": {
      "kind": "query",
      "datasource": "postgres",
      "query": "SELECT DISTINCT dataset FROM quality.cuts ORDER BY 1",
      "multi": true
    },
    "cut": {
      "kind": "query",
      "datasource": "postgres",
      "query": "SELECT cut::text FROM quality.cuts WHERE dataset IN (${dataset:sqlstring}) ORDER BY cut DESC LIMIT 60",
      "all": false
    },
    "jobs": {
      "kind": "query",
      "datasource": "postgres",
      "query": "SELECT coalesce(string_agg(x.id::text, '|' ORDER BY x.id::text), '[^\\x00-\\x{10FFFF}]') FROM quality.cuts c CROSS JOIN LATERAL (VALUES (c.extract_job), (c.evaluate_job)) x(id) WHERE c.dataset IN (${dataset:sqlstring}) AND c.cut::text IN (${cut:sqlstring}) AND x.id IS NOT NULL",
      "all": false,
      "hide": true
    },
    "run_id": {
      "kind": "query",
      "datasource": "postgres",
      "query": "SELECT coalesce(string_agg(c.id::text, '|' ORDER BY c.id::text), '[^\\x00-\\x{10FFFF}]') FROM quality.cuts c WHERE c.dataset IN (${dataset:sqlstring}) AND c.cut::text IN (${cut:sqlstring})",
      "all": false,
      "hide": true
    },
    "previous_cut": {
      "kind": "query",
      "datasource": "postgres",
      "query": "SELECT coalesce((SELECT cut::text FROM (SELECT cut FROM quality.run_summary WHERE dataset = ${dataset:sqlstring} ORDER BY cut DESC LIMIT 60) recent WHERE cut < ${cut:sqlstring}::date ORDER BY cut DESC LIMIT 1), '')",
      "all": false,
      "hide": true
    },
    "dimension": {
      "kind": "query",
      "datasource": "postgres",
      "query": "SELECT dimension FROM quality.group_metrics WHERE dataset = ${dataset:sqlstring} AND cut = ${cut:sqlstring}::date UNION SELECT dimension FROM quality.distribution_checks WHERE dataset = ${dataset:sqlstring} AND cut = ${cut:sqlstring}::date AND dimension <> '' UNION SELECT dimension FROM quality.queue_findings WHERE dataset = ${dataset:sqlstring} AND cut = ${cut:sqlstring}::date ORDER BY 1",
      "multi": true,
      "repeat": true
    },
    "drift_variable": {
      "kind": "query",
      "datasource": "postgres",
      "query": "SELECT DISTINCT c.variable FROM quality.distribution_checks c JOIN quality.distribution_checks p ON p.tenant_id = c.tenant_id AND p.dataset = c.dataset AND p.variable = c.variable AND p.dimension = '' AND p.percentiles IS NOT NULL AND p.cut = NULLIF(${previous_cut:sqlstring}, '')::date WHERE c.dataset = ${dataset:sqlstring} AND c.cut = ${cut:sqlstring}::date AND c.dimension = '' AND c.percentiles IS NOT NULL ORDER BY 1",
      "multi": true,
      "repeat": true
    },
    "vm": {
      "kind": "query",
      "datasource": "mimir",
      "query": "label_values(up{job=\"host\"}, vm)",
      "all": false
    }
  },
  "chartColumns": {
    "labels": {
      "grp": "group",
      "from_icd": "icdBin",
      "from_band": "previousCut",
      "to_band": "thisCut",
      "cell": "sfcCell",
      "ok": "sfcRight",
      "total": "sfcActive",
      "passes": "sfcState",
      "missing": "sfcMissing",
      "margin": "sfcMargin",
      "closeness": "sfcCloseness",
      "sfc": "sfcValue",
      "serious_share": "seriousShare",
      "before": "previousCut",
      "now": "thisCut",
      "base": "previousCut",
      "open": "openFindings",
      "overdue": "overdueFindings",
      "resolved": "resolvedFindings",
      "oldest_days": "oldestOpen",
      "sla_days": "sla",
      "band": "age",
      "empty_share": "emptyShare",
      "distinct_values": "distinct",
      "pattern_share": "patternShare",
      "ms": "stageMs",
      "per_million": "perMillion",
      "previous_ms": "previousMs",
      "previous_per_million": "previousPerMillion",
      "signal": "reading"
    },
    "values": {
      "severity": "severityName",
      "signal": "signal",
      "stage": "stageName",
      "from_band": "bandName",
      "to_band": "bandName",
      "band": "recencyBand",
      "grp": "emptyGroup",
      "segment": "emptyGroup"
    }
  },
  "dashboards": [

          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- Views of personal data over time, one series per kind of view (source, dataset, lake).\nSELECT $__timeGroupAlias(a.occurred_at, $__interval), split_part(a.resource, '/', 1) AS metric, count(*) AS value\nFROM public.admin_audit_events a\nWHERE $__timeFilter(a.occurred_at)\n  AND a.event_type = 'records_viewed'\n  AND ('__all' IN (${who:sqlstring}) OR a.admin_id::text IN (${who:sqlstring}))\n  AND (${resource:sqlstring} = '' OR strpos(a.resource, ${resource:sqlstring}) > 0)\nGROUP BY 1, 2\nORDER BY 1, 2",
          "refId": "A"
        }
      ],
      "maxDataPoints": 100,
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },

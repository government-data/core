      "id": 2,
      "type": "timeseries",
      "title": "CPU usada, por modo (%)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"

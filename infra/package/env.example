# The .env of an installation of quality-data (decision 0080, point 5):
# the template quality-sdk's installer writes as
# /opt/quality-data/quality-data/.env (0600, beside the version folders),
# filling the values; the update agent fills the IMAGE_* lines with the
# signed index's digests (<repository>@sha256:…). No secret here: the
# installer writes them, and the files of secrets/ (see compose.yml).

# --- Where this installation's files are (required) --------------------------
QD_MODULE_DIR=/opt/quality-data/quality-data
# The node agent's directory on this VM (machine.pem): Traefik's machine
# certificate is copied from it into internal/ and renewed in place.
QD_MACHINE_DIR=
# The installer's one-shots (infra/postgres/app-machine.yml and
# updater-certificate.yml, decision 0080, point 7).
QD_CA_DIR=/opt/quality-data/quality-data/ca
QD_UPDATER_DIR=/etc/quality-data/internal

# --- Images: written by the update agent --------------------------------------
IMAGE_API=
IMAGE_WEB=
IMAGE_TRAEFIK=
IMAGE_POSTGRES=

# --- Names and ports -----------------------------------------------------------
# The people's address, and the machines' (the application VM's machine
# name, the one its certificate carries).
APP_DOMAIN=
INTERNAL_DOMAIN=
# Let's Encrypt's contact; without public DNS Traefik serves certs/local.crt.
ACME_EMAIL=
# The VM's name in every log line.
OBS_VM=
TRAEFIK_INTERNAL_PORT=9443
TRAEFIK_LAKEGATE_PORT=9444
TRAEFIK_METRICS_PORT=9445

# --- The database --------------------------------------------------------------
# The application VM's machine name, the one PostgreSQL's certificate
# carries (as INTERNAL_DOMAIN); the API and the workers reach it by it.
POSTGRES_SERVER_NAME=
# Where the workers reach it (TLS and their certificates).
POSTGRES_PORT=5432
POSTGRES_DB=knime
APP_DB_USER=knime_app
# Written by the installer. The superuser's is read from
# secrets/postgres_superuser_password by PostgreSQL; Compose still requires
# the variable. The application role's reaches PostgreSQL's first start.
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=

            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- How long the oldest job ready to take has waited; 0 with none ready.\nSELECT coalesce(extract(epoch FROM now() - min(j.not_before)), 0) AS oldest_ready\nFROM quality.jobs j\nWHERE j.state = 'queued' AND j.not_before <= now()",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
